# ============================================================
# VERCEL ENVIRONMENT VARIABLES
# Copy these into Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# Supabase — same values as your .env.local
NEXT_PUBLIC_SUPABASE_URL=https://satluqqzluoohhvbhfjm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Your Vercel domain — replace with your actual domain
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
NEXT_PUBLIC_BASE_DOMAIN=your-project.vercel.app

# Tap Payments (Saudi Arabia)
TAP_SECRET_KEY=sk_test_...
TAP_PUBLIC_KEY=pk_test_...
TAP_WEBHOOK_SECRET=...

# ============================================================
# SUPABASE SETTINGS REQUIRED (Dashboard → Authentication)
# ============================================================
# 1. Auth → URL Configuration → Site URL: set to your Vercel domain
# 2. Auth → URL Configuration → Redirect URLs: add https://your-project.vercel.app/**
# 3. Auth → Email → Enable "Email OTP" (for the OTP login feature)
# 4. Auth → Email → OTP Expiry: 600 (10 minutes recommended)
